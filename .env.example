


# ============================================================
# GuMMy platform — environment template
# Copy this file to .env and fill in REAL values.
# NEVER commit the real .env file. NEVER put these in frontend code.
# ============================================================

# --- Discord application (apps/bot) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only needed later for OAuth2 login on the dashboard:
DISCORD_OAUTH_REDIRECT_URI=

# --- Turso / libSQL database (packages/database) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- Branding (kept configurable so no name is hardcoded in source) ---
BRAND_NAME=GuMMy



